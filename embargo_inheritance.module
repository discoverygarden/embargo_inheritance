<?php

/**
 * @file
 * General hook implementations.
 */

use Drupal\embargo_inheritance\EmbargoStorage;

/**
 * Implements hook_entity_type_alter().
 */
function embargo_inheritance_entity_type_alter(array &$entity_types) : void {
  /** @var \Drupal\Core\Entity\EntityTypeInterface[] $entity_types */
  $entity_types['embargo']->setStorageClass(EmbargoStorage::class);
}
